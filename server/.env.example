OPENAI_API_KEY=
# Official Live delegation guide recommends gpt-6-luna (verified 2026-11-15).
OPENAI_TEXT_MODEL=gpt-6-luna
DEV_CLIENT_TOKEN=replace-with-a-random-long-token
HOST=0.0.0.0
PORT=8789
TASK_CONCURRENCY=2
MAX_PENDING_TASKS=20
TASK_TIMEOUT_MS=180000
MAX_OUTPUT_TOKENS=4000
MAX_LIVE_SECONDS=3600
LIVE_LEASE_MS=45000
# USD estimates shown in the app (verified 2026-11-15). Override if prices change.
PRICE_LIVE_PER_MINUTE=0.05
PRICE_TEXT_INPUT_PER_M=0.10
PRICE_TEXT_CACHED_PER_M=0.01
PRICE_TEXT_OUTPUT_PER_M=0.50
# CLI mode (API | CLI switch in the app): voice + agent through `codex app-server`
# with the ChatGPT login of this computer (no API key). Requires codex CLI >= 0.162.
CODEX_BIN=codex
# Folder the Codex agent works in (created if missing). Default: server/codex-workspace
# CODEX_CWD=/absolute/path
# read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write
# CODEX_MODEL=
