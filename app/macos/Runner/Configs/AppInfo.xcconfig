// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = GPT Live

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = dev.voicelive.flutterGptLive

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 dev.voicelive. All rights reserved.

// #DEV-FLAVOR: the Debug build is a separate app ("GPT Live Dev") with its own
// bundle id, sandbox container, preferences and recordings, so development
// never replaces or quits the Release app in daily use.
PRODUCT_NAME[config=Debug] = GPT Live Dev
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = dev.voicelive.flutterGptLive.dev
